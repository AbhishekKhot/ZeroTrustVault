# Copy to `.env` (which is gitignored) and fill in the required values.
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────
# Postgres password for the dev DB. Use any non-empty value for local dev.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=

# JWT signing secret. Backend rejects boot if shorter than 32 chars.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Optional (sensible defaults if left blank) ──────────────────────────────
POSTGRES_USER=pm
POSTGRES_DB=password_manager
NODE_ENV=production
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
PBKDF2_ITERATIONS=600000
DB_POOL_MAX=20
REQUEST_TIMEOUT_MS=10000
